# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments (users create their own)
.venv/
.venvs/
venv/
env/

# Downloaded wheels (users download their own)
.wheelhouse/
*.whl

# Harness run artifacts
artifacts/

# Raw local run files are ignored by default. Sanitized published evidence
# bundles under results/ are reviewed before being committed.
*.jsonl
!results/**/*.jsonl
operations/

# Local credentials (must never be committed)
*.key
credentials/
.env
.env.*
secrets/

# Editor
.DS_Store
.idea/
.vscode/
*.swp
